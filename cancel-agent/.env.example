# Copy this file to .env and fill in real values for LOCAL DEVELOPMENT.
# On LangGraph Platform, set these as deployment secrets/env vars instead -
# .env is not used in production, only by `python main.py` / `langgraph dev`.

OPENAI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini

BOOKING_API_BASE_URL=https://demo.catalystsystems.io:1102
BOOKING_API_TIMEOUT_SECONDS=15

OTP_PROVIDER=dummy
AUTHENTICA_API_KEY=
AUTHENTICA_BASE_URL=http://api.authentica.sa/api/v2
AUTHENTICA_TEMPLATE_ID=31
AUTHENTICA_FALLBACK_EMAIL=

DEFAULT_COUNTRY_CODE=20
AGENT_DATA_DIR=
LOG_LEVEL=INFO
